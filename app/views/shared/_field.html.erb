<div class="flex flex-col gap-1">
  <%= form.label attribute, label, class: "text-sm opacity-80" %>
  <%= form.public_send("#{type}_field", attribute, class: "rounded-lg bg-input px-3 py-2 w-full", **local_assigns.slice(:value)) %>
  <% form.object&.errors&.full_messages_for(attribute)&.each do |message| %>
    <p class="text-sm text-danger"><%= message %></p>
  <% end %>
</div>
