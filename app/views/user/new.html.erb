<div class="flex grow flex-col items-center gap-4">
    <h1 class="mb-6 text-2xl font-bold text-gray-800 text-center">新規登録</h1>

    <%= form_with model: @user, url: signup_path, class: "flex flex-col gap-4 min-w-sm" do |form| %>
      <%= render "shared/field", form:, attribute: :name, label: "名前", type: :text %>
      <%= render "shared/field", form:, attribute: :nickname, label: "ニックネーム", type: :text %>
      <%= render "shared/field", form:, attribute: :email, label: "メールアドレス", type: :email %>
      <%= render "shared/field", form:, attribute: :password, label: "パスワード", type: :password %>
      <%= render "shared/field", form:, attribute: :password_confirmation, label: "パスワード確認", type: :password %>
      <%= form.submit "登録", class: "transition rounded-md bg-primary px-4 py-2 font-medium text-white hover:bg-primary-hover cursor-pointer" %>
    <% end %>

    <p class="mt-4 text-sm">
      または<%= link_to "ログイン", login_path, class: "text-link underline" %>
    </p>
</div>
