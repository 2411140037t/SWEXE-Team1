<div class="flex grow flex-col items-center gap-4">
    <h1 class="mb-6 text-2xl font-bold text-gray-800 text-center">ログイン</h1>

    <% if flash[:alert] %>
      <p class="text-sm text-danger"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: login_path, class: "flex flex-col gap-4 min-w-sm" do |form| %>
      <%= render "shared/field", form:, attribute: :email, label: "メールアドレス", type: :email %>
      <%= render "shared/field", form:, attribute: :password, label: "パスワード", type: :password %>
      <%= form.submit "ログイン", class: "transition rounded-md bg-primary px-4 py-2 font-medium text-white hover:bg-primary-hover cursor-pointer" %>
    <% end %>

    <p class="mt-4 text-sm">
      または<%= link_to "新規登録", signup_path, class: "text-link underline" %>
    </p>
</div>
